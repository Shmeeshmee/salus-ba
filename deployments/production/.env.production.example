# Every variable the production stack reads (docker-compose.prod.yml), with placeholders only: never a real value
# in this file. The whole filled-in file is one GitHub Actions secret, SALUS_ENV_FILE, of the `production`
# environment, kept as one secure note in the owner's Bitwarden; the deploy job checks that every variable set below
# has a value and writes the file to /opt/salus/.env (mode 600, owner deploy) on each deploy (docs/deploy/README.md).
#
# [secret]      a secret value: generate it on a trusted machine and store it in Bitwarden before it goes anywhere.
# [variable]    not secret, but in the same file (SALUS_DOMAIN also as the repository variable of the same name).
# [default]     optional: the compose file has a default; set it only to change that.
#
# Passwords and keys that go into a URL must be URL-safe: generate them with `openssl rand -hex 32`. Keys that the
# binaries read as base64 of 32 bytes: `openssl rand -base64 32`.
#
# SALUS_TAG (the images' commit SHA) is not here: the deploy writes it to /opt/salus/release.env.
#
# BINARY_KEK and TOTP_KEY are not here, and the deploy refuses an env file that sets them (ADR 0011): they live in
# the key files on the encrypted volume (SALUS_DATA_DIR/keys/, root-only, written by `salus-volume setup` from
# Bitwarden, where each is its own item), and reach the api and the worker as compose secrets
# (deployments/production/README.md "Keys").
#
# Set by the compose file itself, not here: DATABASE_URL and RETENTION_DATABASE_URL (from the passwords below),
# REDIS_URL, HTTP_ADDR (:8080), LIVEKIT_URL, LIVEKIT_PUBLIC_URL (wss://livekit.SALUS_DOMAIN), S3_ENDPOINT,
# S3_REGION, CLAMD_ADDR, TRUSTED_PROXY_CIDRS, FHIR_BASE_URL (https://app.SALUS_DOMAIN/fhir/R4), WEB_BASE_URL
# (https://app.SALUS_DOMAIN). FAKE_ENGINE_SCRIPT is for make e2e only and is never set in production.

# --- Names and addresses -------------------------------------------------------------------------------------

# [variable] The domain (not chosen yet). The stack serves the apex, app., api., livekit. and turn. under it; each
# needs a DNS A record to the server (docs/deploy/README.md).
SALUS_DOMAIN=salus.example

# [variable] Let's Encrypt's contact address for the certificates (expiry warnings).
SALUS_ACME_EMAIL=acme-contact@salus.example

# [default] The ACME directory. Default: Let's Encrypt production. For a first run on a new server, use the
# staging directory, https://acme-staging-v02.api.letsencrypt.org/directory, then remove this line and delete
# Caddy's staging certificates (README.md).
# SALUS_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# [default] The GHCR namespace of the images. Default: shmeeshmee.
# GHCR_OWNER=shmeeshmee

# [variable] The server's public IPv4 address (Hetzner console), which LiveKit offers clients in its ICE
# candidates (rtc.node_ip).
LIVEKIT_NODE_IP=203.0.113.10

# --- Postgres -------------------------------------------------------------------------------------------------

# [secret] The password of salus, the database owner: Postgres's superuser, used by migrate (and salusctl) only.
# Hex. Postgres sets it when it creates the volume; changing it later needs ALTER ROLE as well.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# [secret] The password of salus_app, the role every app binary logs in as. Hex; migrate sets it on every run.
APP_DATABASE_PASSWORD=replace-with-openssl-rand-hex-32

# [secret] The password of salus_retention, the retention job's role (the worker only). Hex; migrate sets it.
RETENTION_DATABASE_PASSWORD=replace-with-openssl-rand-hex-32

# --- The api's keys -------------------------------------------------------------------------------------------

# [secret] Keys the HMAC that names the login rate-limit counters in Redis (base64 of at least 32 bytes).
RATE_LIMIT_KEY=replace-with-openssl-rand-base64-32

# --- LiveKit --------------------------------------------------------------------------------------------------

# [secret] The LiveKit API key pair, shared by LiveKit, the api, the worker and the agent; the key also signs
# LiveKit's webhooks. The key is an identifier (letters and digits, e.g. `salus` plus `openssl rand -hex 6`), the
# secret at least 32 characters (`openssl rand -hex 32`). Never the dev pair of deployments/livekit.yaml.
LIVEKIT_API_KEY=replace-with-a-key-id
LIVEKIT_API_SECRET=replace-with-openssl-rand-hex-32

# --- The object store (Garage) and the files' key ------------------------------------------------------------

# [secret] Garage's RPC secret: 32 bytes in hex (`openssl rand -hex 32`).
GARAGE_RPC_SECRET=replace-with-openssl-rand-hex-32

# [secret] The access key Garage creates on its first start and grants the bucket; the api and the worker use it.
# The id is GK followed by 24 hex digits (`echo GK$(openssl rand -hex 12)`), the secret 64 hex digits
# (`openssl rand -hex 32`). Changing them later needs Garage's CLI (README.md).
S3_ACCESS_KEY_ID=GKreplace-with-24-hex-digits
S3_SECRET_ACCESS_KEY=replace-with-openssl-rand-hex-32

# [default] The bucket of the attachments. Default: salus-binaries.
# S3_BUCKET=salus-binaries

# [variable] The id of the key-encryption key (BINARY_KEK, in the key file on the encrypted volume), stored with
# every wrapped key; a new id for a new KEK (e.g. prod-1).
BINARY_KEK_ID=prod-1

# --- E-mail ---------------------------------------------------------------------------------------------------

# Decided: an EU SMTP relay, Brevo or Mailjet (ADR 0011 point 5); its DPA pending (point 1): no e-mail to a real
# person before it is signed and recorded in docs/privacy/processors.md. Setup and DNS: docs/deploy/README.md.

# [variable] The relay, host:port. Brevo: smtp-relay.brevo.com:587; Mailjet: in-v3.mailjet.com:587.
SMTP_ADDR=smtp-relay.brevo.com:587

# [default] starttls (the default, port 587) or tls (implicit TLS, port 465). none is for the local Mailpit only
# and is refused with a login.
# SMTP_TLS=starttls

# [secret] The SMTP login (with the password, the relay's credential). Brevo: the login on Settings, SMTP & API, SMTP tab (your account e-mail or an address
# ending in @smtp-brevo.com); Mailjet: the API key (Account settings, API key management).
SMTP_USERNAME=replace-with-the-relays-smtp-login

# [secret] Brevo: an SMTP key generated on that SMTP tab (not an API key); Mailjet: the API key's secret key.
SMTP_PASSWORD=replace-with-the-relays-smtp-key

# [variable] The From header and envelope sender, Name <address>, on the domain verified at the relay (SPF, DKIM
# and DMARC, docs/deploy/README.md); never a free-mail address. Quoted, so a shell reading the file keeps it whole.
SMTP_FROM="Salus <noreply@salus.example>"

# [variable] The patient app's link base for appointment e-mails (<PATIENT_APP_URL>/appointments). The patient
# app's link domain is not decided yet: until it is, set the address patients should be sent to.
PATIENT_APP_URL=https://patient.salus.example

# --- Engines: decided, the fakes in production until their DPAs are signed (ADR 0011 point 6) ----------------

# [default] fake (the default) or azure. Azure only after its DPA, an EU region and zero data retention.
# STT_ENGINE=fake
# [secret] Only for STT_ENGINE=azure: the EU region and the key.
# AZURE_SPEECH_REGION=
# AZURE_SPEECH_KEY=

# [default] fake (the default) or anthropic. Anthropic only after its DPA and zero data retention.
# LLM_ENGINE=fake
# [secret] Only for LLM_ENGINE=anthropic. LLM_MODEL defaults to the binaries' model.
# ANTHROPIC_API_KEY=
# LLM_MODEL=

# --- The encrypted volume ------------------------------------------------------------------------------------

# [default] Where the LUKS volume is mounted (salus-volume setup's mount point): Postgres's and Garage's data and
# the key files. Default: /mnt/salus-data.
# SALUS_DATA_DIR=/mnt/salus-data

# --- Memory limits (README.md "Memory budget"; defaults for 4 vCPU / 8 GB) -----------------------------------

# [default] Per service, in Docker's units (m, g).
# SALUS_MEM_CADDY=192m
# SALUS_MEM_MIGRATE=256m
# SALUS_MEM_API=512m
# SALUS_MEM_WORKER=768m
# SALUS_MEM_SCHEDULER=128m
# SALUS_MEM_NOTIFIER=128m
# SALUS_MEM_AGENT=384m
# SALUS_MEM_WEB=64m
# SALUS_MEM_LANDING=64m
# SALUS_MEM_POSTGRES=1024m
# SALUS_MEM_REDIS=256m
# SALUS_REDIS_MAXMEMORY=192mb
# SALUS_MEM_LIVEKIT=768m
# SALUS_MEM_OBJECTSTORE=384m
# SALUS_MEM_CLAMD=2048m
