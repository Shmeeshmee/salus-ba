# Settings for bootstrap.sh and the nightly backup (salus-backup). Copy to bootstrap.conf, fill in, and pass it with
# --config; the bootstrap installs it as /etc/salus/bootstrap.conf (root, 600), where later runs and the backup read
# it.
# Format: KEY=value, one per line, '#' starts a comment line (no comments after a value). The file is parsed, never
# executed. Only public keys go here: nothing in this file is secret.

# --- Access ----------------------------------------------------------------------------------------------------

# Public key(s) that may log in as the deploy user: the operator's and the deploy workflow's (GitHub Actions). One
# line per key; repeat the setting for more. Required: the bootstrap refuses to continue without one, and it
# replaces the deploy user's authorized_keys with exactly these.
DEPLOY_SSH_KEY=ssh-ed25519 AAAA... operator@laptop
#DEPLOY_SSH_KEY=ssh-ed25519 AAAA... github-actions-deploy

# yes gives the deploy user passwordless sudo. The docker group already makes it root-equivalent, so this adds
# convenience, not power. With no (the default, README.md "Later runs and root access"), root, and so a later
# bootstrap run, is reached through Hetzner's console.
DEPLOY_SUDO=no

# The SSH port sshd listens on and ufw allows. Changing it on a running server keeps the old ufw rule; remove that
# by hand once the new port works.
SSH_PORT=22

# Further ports ufw must keep open for other software already on this server, space-separated, each PORT/tcp or
# PORT/udp. Salus's own ports (80/tcp, 443/tcp, 443/udp, 3478/udp, 7881/tcp, 7882/udp) and SSH_PORT are always open.
UFW_EXTRA_PORTS=

# The bootstrap refuses to enable ufw while a service listens on a public address that no allowed port or existing
# ufw rule covers. yes blocks such services on purpose (each is still listed as a warning).
UFW_ACCEPT_BLOCKING=no

# --- Unattended security upgrades -------------------------------------------------------------------------------

# When the daily security upgrade runs (HH:MM, server time; up to 15 minutes later at random).
UPGRADE_TIME=04:00
# yes reboots automatically when an upgrade needs it, at UPGRADE_REBOOT_TIME. Off by default: a reboot interrupts
# consultations; reboot by hand in a quiet hour instead (/var/run/reboot-required says when).
UPGRADE_AUTO_REBOOT=no
UPGRADE_REBOOT_TIME=04:30

# --- Backup to the Hetzner Storage Box (docs/deploy/backup-restore.md) -----------------------------------------
# Until BACKUP_HOST, BACKUP_USER, BACKUP_KNOWN_HOST and BACKUP_AGE_RECIPIENT are all set, the backup timer is
# installed but not enabled.

# The Storage Box (or its sub-account): host, SSH port (23 on Hetzner) and user.
BACKUP_HOST=uXXXXXX.your-storagebox.de
BACKUP_PORT=23
BACKUP_USER=uXXXXXX-subN
# The directories on the Storage Box for the Postgres dumps and for Garage's objects, relative to the user's home;
# created when missing.
BACKUP_PATH=salus/postgres
BACKUP_OBJECTS_PATH=salus/objects

# The Storage Box's host key, pinned, as a known_hosts line. Get it with
#   ssh-keyscan -p 23 -t ed25519 uXXXXXX.your-storagebox.de
# and compare its fingerprint (ssh-keygen -lf) with the one Hetzner publishes. Repeat the setting for more keys.
BACKUP_KNOWN_HOST=[uXXXXXX.your-storagebox.de]:23 ssh-ed25519 AAAA...

# The age public key the dumps and the object archives are encrypted to; its private half is kept offline (Bitwarden), never on the
# server. Repeat the setting to encrypt to a second key as well.
BACKUP_AGE_RECIPIENT=age1...

# When the nightly backup starts (HH:MM, server time), and the random delay added to it: the Postgres dump, then
# Garage's objects. A run missed while the server was off runs at the next boot.
BACKUP_TIME=02:30
BACKUP_RANDOM_DELAY=30min

# Days the dumps and the object archives are kept on the Storage Box (ADR 0011: 14). Erased data stays in them
# this long.
BACKUP_RETENTION_DAYS=14

# --- Alerts (docs/deploy/backup-restore.md "Alerting") ---------------------------------------------------------

# Who is mailed when a backup fails, or when the daily check finds the newest backup of either kind on the Storage
# Box older than BACKUP_MAX_AGE_HOURS (or none). One bare address. The mail goes through the SMTP relay of
# /opt/salus/.env (SMTP_ADDR, SMTP_USERNAME, SMTP_PASSWORD, SMTP_TLS, SMTP_FROM) and carries the host, the unit,
# the time and the exit status only. Empty: failures are logged on the server only (the bootstrap warns).
ALERT_EMAIL=
# When the daily check runs (HH:MM, server time; up to 10 minutes later at random), and the age it allows.
BACKUP_CHECK_TIME=08:00
BACKUP_MAX_AGE_HOURS=26

# yes also keeps the encrypted dumps in BACKUP_STAGING_DIR on the server, pruned by the same retention. Off by
# default: a copy on the same disk does not survive the loss of the server.
BACKUP_KEEP_LOCAL=no

# How long a backup waits for the database container to be healthy (after a boot, a missed backup can start before
# the stack is up), in seconds.
BACKUP_WAIT_SECONDS=600

# Rarely changed: the compose project and the services of the database and the object store, the stack's env file
# (the objects backup reads S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY and S3_BUCKET from it, the alerts SMTP_*), the
# backup's own SSH key (generated by the bootstrap when missing), the pinned host key file, and the local staging
# directory (it holds one encrypted backup while it uploads: leave room for the largest object archive).
BACKUP_COMPOSE_PROJECT=salus
BACKUP_PG_SERVICE=postgres
BACKUP_OBJECTS_SERVICE=objectstore
BACKUP_ENV_FILE=/opt/salus/.env
BACKUP_SSH_KEY_FILE=/root/.ssh/salus-backup
BACKUP_KNOWN_HOSTS_FILE=/etc/salus/backup_known_hosts
BACKUP_STAGING_DIR=/opt/salus/backups
