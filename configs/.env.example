# Local settings. Synthetic values only; never a real credential or real personal data.
#
# Compose sets the app's variables itself (deployments/docker-compose.yml). To move a published port
# because another project holds it, copy the SALUS_*_PORT lines you need to deployments/.env (git-ignored);
# compose reads that file automatically.

# Host ports (127.0.0.1 only)
SALUS_API_PORT=8080
SALUS_MAILPIT_PORT=8025
SALUS_LIVEKIT_PORT=7880
# LiveKit's WebRTC TCP and UDP media ports. LiveKit announces 7881 and 7882 to clients, so a browser on the host
# reaches media only on the defaults; move them only for a second stack that runs tests (a worktree).
SALUS_LIVEKIT_TCP_PORT=7881
SALUS_LIVEKIT_UDP_PORT=7882
SALUS_WEB_PORT=5173
SALUS_LANDING_PORT=8090
SALUS_LANDING_DEV_PORT=5174

# What every Go binary reads (internal/config). The values compose uses. The app binaries (api, worker,
# notifier, scheduler) log in as salus_app; migrate logs in as the owner and sets salus_app's password:
# DATABASE_URL=postgres://salus_app:local-app-password@postgres:5432/salus?sslmode=disable
# DATABASE_URL=postgres://salus:salus@postgres:5432/salus?sslmode=disable (migrate only)
# APP_DATABASE_PASSWORD=local-app-password (migrate only; unset in production when provisioned elsewhere)
# The retention job's role, salus_retention, has its own login: only the worker reads RETENTION_DATABASE_URL
# (config.LoadRetention), for the retention_apply job alone; migrate sets its password from
# RETENTION_DATABASE_PASSWORD (unset in production when provisioned elsewhere).
# RETENTION_DATABASE_URL=postgres://salus_retention:local-retention-password@postgres:5432/salus?sslmode=disable (worker only)
# RETENTION_DATABASE_PASSWORD=local-retention-password (migrate only)
# The aggregate builds' role, salus_stats (ADR 0013), likewise: migrate sets its password from
# STATS_DATABASE_PASSWORD; only the worker reads STATS_DATABASE_URL, for the clinic statistics' builds.
# STATS_DATABASE_URL=postgres://salus_stats:local-stats-password@postgres:5432/salus?sslmode=disable (worker only)
# STATS_DATABASE_PASSWORD=local-stats-password (migrate only)
# REDIS_URL=redis://redis:6379/0
# HTTP_ADDR=:8080

# The api's auth settings (docs/accounts/SPEC.md). Both keys are base64 of 32 bytes. TOTP_KEY seals TOTP
# secrets: local and CI only; production: the root-only key file on the encrypted volume (TOTP_KEY_FILE, ADR 0011).
# RATE_LIMIT_KEY keys the HMAC that names the login rate-limit counters, so no e-mail or IP is readable in
# Redis. TRUSTED_PROXY_CIDRS lists the proxies whose X-Forwarded-For is believed; empty means none.
# TOTP_KEY=bG9jYWwtb25seS1zeW50aGV0aWMtdG90cC1rZXktMzI=
# RATE_LIMIT_KEY=bG9jYWwtb25seS1zeW50aGV0aWMtcmF0ZWxpbWl0LWs=
# TRUSTED_PROXY_CIDRS=10.0.0.0/8,fd00::/8
# WEBHOOK_KEY seals the clinics' webhook secrets (SAL-29), base64 of 32 bytes, a key of its own; the api and the
# worker require it. Local and CI only; production: the root-only key file on the encrypted volume
# (WEBHOOK_KEY_FILE, ADR 0011).
# WEBHOOK_KEY=bG9jYWwtb25seS1zeW50aGV0aWMtd2ViaG9vay1rZXk=
# The notifier's push services (SAL-29, docs/deploy/push.md): the fake (it sends nothing) unless set. The keys are
# files (production: the root-only key files), never values here. All of a platform's variables or none.
# FCM_CREDENTIALS_FILE=/run/secrets/fcm_credentials
# APNS_KEY_FILE=/run/secrets/apns_key
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_SANDBOX=false
# Text messages (docs/plans/appointments.md, SAL-33 wires them): the fake (it sends nothing) unless SMS_ENGINE=http
# with the provider's https endpoint and a token file. Off until the owner chooses an EU/EEA provider and its DPA is
# recorded (docs/privacy/processors.md).
# SMS_ENGINE=fake
# SMS_HTTP_URL=
# SMS_HTTP_TOKEN_FILE=/run/secrets/sms_token
# FHIR_BASE_URL is the FHIR API's absolute public base, for the links and fullUrls of a search's Bundle
# (required by the api).
# FHIR_BASE_URL=http://localhost:8080/fhir/R4

# The notifier (cmd/notifier) sends e-mail through SMTP_ADDR (Mailpit on the compose network, in plaintext without
# a login; production: an EU relay with SMTP_TLS=starttls or tls and SMTP_USERNAME/SMTP_PASSWORD) from SMTP_FROM,
# with links to WEB_BASE_URL: invite links are <WEB_BASE_URL>/invite#<token>.
# SMTP_ADDR=mailpit:1025
# SMTP_TLS=none
# SMTP_FROM=Salus <no-reply@salus.invalid>
# WEB_BASE_URL=http://localhost:5173
# Appointment e-mails link to <PATIENT_APP_URL>/appointments; compose uses a placeholder that resolves nowhere
# until the patient app has a link domain.
# PATIENT_APP_URL=https://patient.salus.invalid

# LiveKit (docs/consultation/SPEC.md §2 "Configuration"), loaded by the api and the worker only
# (config.LoadLiveKit). The dev key pair is deployments/livekit.yaml's; production's comes from the secret store.
# LIVEKIT_URL=http://livekit:7880
# LIVEKIT_PUBLIC_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=local-only-synthetic-livekit-secret-0123456789

# The object store and the files' key-encryption key (docs/attachments/SPEC.md §2 "Configuration", ADR 0010),
# loaded by the api and the worker only (config.LoadObjectStore); each is required there. Locally the store is the
# compose Garage (service objectstore, compose network only) with a synthetic key pair. BINARY_KEK is base64 of
# 32 bytes and wraps each file's data key; BINARY_KEK_ID is stored with every wrapped key. Local and CI only:
# production's store is its own Garage and its KEK the root-only key file on the encrypted volume (BINARY_KEK_FILE,
# ADR 0011).
# S3_ENDPOINT=http://objectstore:3900
# S3_REGION=garage
# S3_BUCKET=salus-binaries
# S3_ACCESS_KEY_ID=GK5a1a50000000000000000001
# S3_SECRET_ACCESS_KEY=5a1a500000000000000000000000000000000000000000000000000000000001
# BINARY_KEK=bG9jYWwtb25seS1zeW50aGV0aWMtYmluYXJ5LWtlayE=
# BINARY_KEK_ID=local-1
# The worker's malware scanner (config.LoadClamd): clamd's TCP address (service clamd, compose network only).
# CLAMD_ADDR=clamd:3310

# Tests (the tools service): pgtest logs in as salus_app with this password. The role is cluster-wide, so it
# is the value migrate sets.
# TEST_APP_DATABASE_PASSWORD=local-app-password
# TEST_RETENTION_DATABASE_PASSWORD=local-retention-password
# TEST_STATS_DATABASE_PASSWORD=local-stats-password
# The SMTP sender's and the notifier's tests deliver to the compose Mailpit and read its API (then delete
# what they sent); like the database URLs, the tests fail without them.
# TEST_SMTP_ADDR=mailpit:1025
# TEST_MAILPIT_URL=http://mailpit:8025
# Its TLS tests use the STARTTLS and implicit-TLS Mailpits with a synthetic login (deployments/docker-compose.yml).
# TEST_SMTP_STARTTLS_ADDR=mailpit-starttls:1025
# TEST_SMTP_STARTTLS_MAILPIT_URL=http://mailpit-starttls:8025
# TEST_SMTP_TLS_ADDR=mailpit-tls:1025
# TEST_SMTP_TLS_MAILPIT_URL=http://mailpit-tls:8025
# TEST_SMTP_USERNAME=salus-test
# TEST_SMTP_PASSWORD=local-only-synthetic-smtp-password
# The LiveKit provider's tests run against the compose LiveKit and fail without these.
# TEST_LIVEKIT_URL=http://livekit:7880
# TEST_LIVEKIT_API_KEY=devkey
# TEST_LIVEKIT_API_SECRET=local-only-synthetic-livekit-secret-0123456789
# The object store's tests run against the compose Garage, clamd's against the compose clamd; they fail without
# these. Object keys are prefixed per test, and a test deletes what it wrote.
# TEST_S3_ENDPOINT=http://objectstore:3900
# TEST_S3_REGION=garage
# TEST_S3_BUCKET=salus-binaries
# TEST_S3_ACCESS_KEY_ID=GK5a1a50000000000000000001
# TEST_S3_SECRET_ACCESS_KEY=5a1a500000000000000000000000000000000000000000000000000000000001
# TEST_CLAMD_ADDR=clamd:3310

# A second checkout (a git worktree) runs its own stack beside this one: its deployments/.env sets
# COMPOSE_PROJECT_NAME (its containers, network and volumes), SALUS_IMAGE_TAG (its app image, built from its own
# source) and SALUS_*_PORT lines that no other stack holds.
# COMPOSE_PROJECT_NAME=salus-feature
# SALUS_IMAGE_TAG=feature
