# Local settings. Synthetic values only; never a real credential or real personal data.
#
# Compose sets the app's variables itself (deployments/docker-compose.yml). To move a published port
# because another project holds it, copy the SALUS_*_PORT lines you need to deployments/.env (git-ignored);
# compose reads that file automatically.

# Host ports (127.0.0.1 only)
SALUS_API_PORT=8080
SALUS_MAILPIT_PORT=8025
SALUS_LIVEKIT_PORT=7880
SALUS_WEB_PORT=5173
SALUS_LANDING_PORT=8090
SALUS_LANDING_DEV_PORT=5174

# What every Go binary reads (internal/config). The values compose uses. The app binaries (api, worker,
# notifier, scheduler) log in as salus_app; migrate logs in as the owner and sets salus_app's password:
# DATABASE_URL=postgres://salus_app:local-app-password@postgres:5432/salus?sslmode=disable
# DATABASE_URL=postgres://salus:salus@postgres:5432/salus?sslmode=disable (migrate only)
# APP_DATABASE_PASSWORD=local-app-password (migrate only; unset in production when provisioned elsewhere)
# The retention job's role, salus_retention, has its own login: only the worker reads RETENTION_DATABASE_URL
# (config.LoadRetention), for the retention_apply job alone; migrate sets its password from
# RETENTION_DATABASE_PASSWORD (unset in production when provisioned elsewhere).
# RETENTION_DATABASE_URL=postgres://salus_retention:local-retention-password@postgres:5432/salus?sslmode=disable (worker only)
# RETENTION_DATABASE_PASSWORD=local-retention-password (migrate only)
# REDIS_URL=redis://redis:6379/0
# HTTP_ADDR=:8080

# The api's auth settings (docs/accounts/SPEC.md). Both keys are base64 of 32 bytes. TOTP_KEY seals TOTP
# secrets: local and CI only, production takes it from the KMS (needs a KMS decision before production).
# RATE_LIMIT_KEY keys the HMAC that names the login rate-limit counters, so no e-mail or IP is readable in
# Redis. TRUSTED_PROXY_CIDRS lists the proxies whose X-Forwarded-For is believed; empty means none.
# TOTP_KEY=bG9jYWwtb25seS1zeW50aGV0aWMtdG90cC1rZXktMzI=
# RATE_LIMIT_KEY=bG9jYWwtb25seS1zeW50aGV0aWMtcmF0ZWxpbWl0LWs=
# TRUSTED_PROXY_CIDRS=10.0.0.0/8,fd00::/8
# FHIR_BASE_URL is the FHIR API's absolute public base, for the links and fullUrls of a search's Bundle
# (required by the api).
# FHIR_BASE_URL=http://localhost:8080/fhir/R4

# The notifier (cmd/notifier) sends e-mail through SMTP_ADDR (Mailpit on the compose network; SES is not
# wired until its DPA is signed) with links to WEB_BASE_URL: invite links are <WEB_BASE_URL>/invite#<token>.
# SMTP_ADDR=mailpit:1025
# WEB_BASE_URL=http://localhost:5173

# Tests (the tools service): pgtest logs in as salus_app with this password. The role is cluster-wide, so it
# is the value migrate sets.
# TEST_APP_DATABASE_PASSWORD=local-app-password
# TEST_RETENTION_DATABASE_PASSWORD=local-retention-password
# The SMTP sender's and the notifier's tests deliver to the compose Mailpit and read its API (then delete
# what they sent); like the database URLs, the tests fail without them.
# TEST_SMTP_ADDR=mailpit:1025
# TEST_MAILPIT_URL=http://mailpit:8025
